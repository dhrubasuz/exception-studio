{
  "name": "exception-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A full-stack connector reliability lab with team roles, durable retries, approvals and traceable delivery.",
  "author": "Dhruba Poudel",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build",
    "start": "node dist/server/index.js",
    "test:api": "tsc -p tsconfig.server.json && node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test": "tsc -p tsconfig.server.json && node --test tests/*.test.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.mjs\" \"*.json\" \"*.ts\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.mjs\" \"*.json\" \"*.ts\" \".prettierrc.json\""
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
